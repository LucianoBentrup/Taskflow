# Environment
NODE_ENV=development

# Server
PORT=3001

# Database - PostgreSQL connection string (e.g., from Neon, Supabase, or Railway)
DATABASE_URL=

# JWT - Access token (short-lived, default 15m)
JWT_SECRET=
JWT_EXPIRES_IN=15m

# JWT - Refresh token (long-lived, default 7d)
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# CORS - allowed origin(s) for frontend requests
# Dev: http://localhost:3000
# Prod: https://taskflow.example.com (replace with your actual domain)
CORS_ORIGIN=http://localhost:3000

# Password hashing
BCRYPT_SALT=10
